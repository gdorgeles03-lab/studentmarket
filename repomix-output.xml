    if (!ok) return;
    setAnnulation(id);
    const { error } = await supabase
      .from("commandes")
      .update({ statut: "annulee" })
      .eq("id", id);
    if (!error) setCommandes(prev => prev.map(c => c.id === id ? { ...c, statut: "annulee" } : c));
    setAnnulation(null);
  }

  const commandesFiltrees = useMemo(() => {
    if (!recherche.trim()) return commandes;
