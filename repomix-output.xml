          {/* PUBLIER */}
          <div style={{ background: "#fff", border: "1px solid #e5e7eb", borderRadius: "16px", padding: "24px" }}>
            <h3 style={{ fontSize: "15px", fontWeight: 700, color: "#111827", marginBottom: "8px" }}>Publier votre annonce</h3>
