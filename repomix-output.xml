                    </span>
                  </div>
                ))}
              </div>
            )}

            <div style={{ padding: "12px 20px", textAlign: "center", borderTop: "1px solid #f3f4f6" }}>
              <a href="/annonces" style={{ fontSize: 13, color: "#15803d", fontWeight: 700 }}>Voir toutes mes annonces →</a>
            </div>
          </div>
          )}

        </main>
      </div>
    </div>
  );
}
</file>

