      const start = new Date(debut.getTime() + i * intervalMs);
      const end   = new Date(debut.getTime() + (i + 1) * intervalMs);
      const label = start.toLocaleDateString("fr-FR", periodeAnalytics === "7j" || periodeAnalytics === "30j"
